# Local dev overrides for `pnpm dev:terminal`. Copy to .env.local.
#
# The browser's wallet RPC. In a deployed stack this is set on the HOST as
# RPC_URL and read at request time by app/layout.tsx; NEXT_PUBLIC_RPC_URL is
# only the build-time fallback, and must stay keyless because `next build`
# inlines it into the client bundle.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Indexer / API and trial engine
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TRIAL_URL=http://localhost:4100
# Vault program id. Must match VAULT_PROGRAM_ID in the root .env
NEXT_PUBLIC_VAULT_PROGRAM_ID=G4E1BiuovMpeUCgyh2222GqAQt4cW5dXSovZipFd89T1
# Optional: devnet test-USDC mint (otherwise read from the on-chain PlatformConfig)
NEXT_PUBLIC_USDC_MINT=BMUqHs7MwDBtQKou7VQrpGWE64dkkAadz1AiMMJkKZmt
NEXT_PUBLIC_NETWORK=devnet
