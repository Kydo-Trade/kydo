{
  "name": "@kydo/keeper",
  "version": "0.2.0",
  "private": true,
  "description": "Keeper service (C4) + price gateway: streams Pyth Hermes, feeds mock oracles (PYTH_MODE=mock) or posts Pyth PriceUpdateV2 accounts (PYTH_MODE=pull), marks every live pool ≤5s, locks and unwinds on breach, vests escrow, unwinds pending redemptions",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --require ts-node/register/transpile-only src/risk.test.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@kydo/sdk": "workspace:*",
    "@pythnetwork/price-service-sdk": "1.8.0",
    "@pythnetwork/pyth-solana-receiver": "0.12.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "eventsource": "^2.0.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/eventsource": "^1.1.15",
    "@types/node": "^18.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
