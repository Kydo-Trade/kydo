  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@kydo/sdk": "workspace:*",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0",
    "@solana/spl-token": "^0.4.9"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^18.19.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
