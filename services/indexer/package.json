{
  "name": "@kydo/indexer",
  "version": "0.2.0",
  "private": true,
  "description": "Indexer + API (C5): program events → Postgres → REST/WS for both frontends; cross-pool hedge detection",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
