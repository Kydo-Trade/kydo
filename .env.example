# Copy to .env (gitignored) and fill in. scripts/dev-stack.sh exports this file
# before starting anything: services run via `pnpm --filter`, which sets cwd to
# the package directory, so their own `dotenv/config` would look for
# services/<name>/.env and never see the repo-root one.
#
# NEVER commit a real RPC or API key here. This file is tracked, and it is not
# only an example: the Dockerfile copies it verbatim into every image as
# /app/.env (Dockerfile:79) and into each Next app before `next build`
# (Dockerfile:105, :126), so a secret written here is published twice over. In
# git history and in the client bundle, and a variable DELETED here goes
# silently missing in production. Deleting the NEXT_PUBLIC_ block below is what
# baked `http://localhost:4000` into the deployed terminal and made every
# browser report "indexer unreachable: Failed to fetch".
#
# Real secrets reach the containers through compose `environment:` instead,
# interpolated from a host-side .env next to docker-compose.yml. dotenv never
# overwrites an existing process env var, so those win over the values here.

# ================================ shared ====================================
# A keyed RPC. The public devnet endpoint below works but rate-limits per IP,
# which the 5 s mark cadence the liquidation buffer is sized for will not
# survive (marks lag and evaluate_risk reverts with OracleStale).
SOLANA_RPC_URL=api.devnet.solana.com
SOLANA_WS_URL=api.devnet.solana.com
VAULT_PROGRAM_ID=G4E1BiuovMpeUCgyh2222GqAQt4cW5dXSovZipFd89T1
# devnet test-USDC mint (printed by scripts/bootstrap-devnet.ts)
USDC_MINT=BMUqHs7MwDBtQKou7VQrpGWE64dkkAadz1AiMMJkKZmt
DATABASE_URL=postgres://kydo:kydo@localhost:5432/kydo
LOG_LEVEL=info

# ========================= keeper / price gateway ===========================
KEEPER_KEYPAIR=~/.config/solana/id.json
PRICE_SOURCE=hermes                 # hermes | exchange (Binance + Coinbase spot) | random-walk (SYNTHETIC. Localhost only, it refuses elsewhere)
PYTH_HERMES_URL=https://hermes.pyth.network
# REQUIRED for PRICE_SOURCE=hermes. Sent as `Authorization: Bearer <key>`.
# The only auth form hermes.pyth.network accepts (query params and X-API-Key
# are rejected). Without it every feed request 401s and the keeper falls back
# to exchange spot. A feed the key does not cover returns 403 and is dropped,
# because one forbidden id 403s the entire stream.
# Read by BOTH the keeper and the indexer. The indexer's stale-price fallback
# needs it too, or it 401s and serves Binance spot on a chart labelled Pyth.
PYTH_API_KEY=
PYTH_HERMES_AUTH=                   # alias for PYTH_API_KEY
# Let a Pyth outage silently degrade to Binance/Coinbase spot. Default false,
# and the default matters: the keeper WRITES whatever it resolves on-chain, so
# a fallback price is the one pools mark against and liquidate on. With it off
# the keeper stops pushing, marks go stale and trading halts on OracleStale.
# The correct outcome for a missing oracle. Read by the keeper and the indexer.
PRICE_ALLOW_EXCHANGE_FALLBACK=true
PYTH_MODE=pull                      # mock = feed program-owned mock oracles | pull = post real Pyth PriceUpdateV2 (the devnet registry is bootstrapped for pull)
PYTH_DRY_RUN=false                  # pull only: build one round, log it, send nothing
KEEPER_INTERVAL_MS=5000             # mark cadence. The liquidation buffer assumes ~5 s
# On-chain push cadence. In pull mode a feed ages by roughly PRICE_PUSH_MS plus
# one round plus confirmation lag, against oracleMaxAgeSlots (now 150 = 60 s).
#
# 10 s, not 2 s. A round is ~21 RPC calls (7 transactions x blockhash + send +
# confirm), so 2 s meant ~10 calls/s from the pusher alone, on top of the risk
# loop and the indexer sharing the same key. Enough to 429 a free Helius plan
# into a spiral where each round took 2.4 s, then 4.9 s, then 9.5 s, and feeds
# went stale anyway. At 10 s it is ~2 calls/s and the 60 s window still leaves
# roughly 3x headroom (worst age ~ cadence + round + lag ~ 20 s = 50 slots).
# Widening the window without slowing the cadence fixes nothing: the window is
# the tolerance, the cadence is the load.
PRICE_PUSH_MS=2000
EXCHANGE_POLL_MS=2000
PRIORITY_FEE_MICROLAMPORTS=50000
JITO_BLOCK_ENGINE_URL=              # empty = plain RPC
JITO_TIP_LAMPORTS=10000

# ============================ indexer / api =================================
API_PORT=4000
STORE=                              # pg | memory (defaults to pg when DATABASE_URL is set)
SNAPSHOT_INTERVAL_MS=10000
BACKFILL_MAX_SIGS=1000
PRICE_STALE_SECS=60                 # on-chain prices older than this are refreshed from Hermes for display (needs PYTH_API_KEY above)
# --- alerting (section 4.6): cross-pool hedges, pool locks, pause events ---
ALERT_WEBHOOK_URL=                  # generic JSON POST; empty = log only
ALERT_SLACK_WEBHOOK_URL=
ALERT_MAX_AGE_SECS=3600
HEDGE_WINDOW_SECS=300
HEDGE_NOTIONAL_TOLERANCE=0.2
KEEPER_LOW_SOL_ALERT=0.5            # warn before the keeper key cannot pay fees
PUBLIC_INVESTOR_URL=http://localhost:3000

# --- faucet: MINTS UNLIMITED TEST USDC. Must be false outside devnet. ---
FAUCET_ENABLED=false
FAUCET_KEYPAIR=~/.config/solana/id.json
FAUCET_MAX_USD=10000                # per-request cap (the CLI faucet has none)
FAUCET_COOLDOWN_HOURS=24

# ============================= trial engine =================================
TRIAL_ATTESTOR_KEYPAIR=~/.config/solana/id.json
TRIAL_PORT=4100
TRIAL_PRICE_SOURCE=indexer
TRIAL_PRICE_POLL_MS=2000
TRIAL_DEPTH_MAJORS=250000
TRIAL_DEPTH_OTHER=50000
# --- SKIPS THE ENTIRE 30-DAY EVALUATION. Must be false outside devnet. ---
TRIAL_DEV_FORCE_PASS=false
# trial engine → indexer, server to server
INDEXER_URL=http://127.0.0.1:4000

# =============================== frontends ==================================
# NEXT_PUBLIC_* is inlined by `next build`, so changing these means rebuilding
# the app images, not restarting them. dev-stack.sh writes apps/*/.env.local
# for a local run; these are for a deployed one.
# Same-origin paths, NOT the api./trial. hostnames the compose header lists.
# Those do not resolve. nginx on the app hosts proxies /api and /trial-api to
# the indexer and trial engine, including the /api/ws upgrade (verified: 200 on
# /api/health and /trial-api/health, 101 Switching Protocols on /api/ws, from
# both terminal.mtsol.stagingapp.co and mtsol.stagingapp.co). wsUrl() in
# apps/terminal/lib/config.ts resolves a relative base against window.location,
# so this is the only value that works on both app hosts at once.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_TRIAL_URL=/trial-api
NEXT_PUBLIC_TERMINAL_URL=https://terminal.kydo.trade
NEXT_PUBLIC_APP_URL=https://kydo.trade
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_VAULT_PROGRAM_ID=G4E1BiuovMpeUCgyh2222GqAQt4cW5dXSovZipFd89T1
NEXT_PUBLIC_USDC_MINT=BMUqHs7MwDBtQKou7VQrpGWE64dkkAadz1AiMMJkKZmt
# Inlined into the client bundle by `next build`, so it is public by
# construction. KEEP THIS KEYLESS. It is committed, and a key here would be
# readable by anyone who opens the site AND permanent in the image.
# This is only the fallback: see RPC_URL below.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# The wallet RPC the browser actually uses. Read at REQUEST time by
# app/layout.tsx (`next start` is a server), so unlike NEXT_PUBLIC_* it is NOT
# inlined at build: set it on the host and restart. No rebuild, and nothing
# keyed lands in the repo. Use a DOMAIN-RESTRICTED key here, and a different key
# in SOLANA_RPC_URL above: the browser and the keeper must not share a quota,
# because the liquidation buffer in config/platform.jsonc is sized on the keeper
# getting its marks in. Unset → falls back to the public endpoint above, which
# the admin panel's "Wallet RPC" row will show.
RPC_URL=

# ================================ scripts ===================================
ANCHOR_WALLET=~/.config/solana/id.json
PLATFORM_CONFIG=config/platform.demo.jsonc   # bootstrap / apply-params source
STATE_FILE=                                  # defaults to .devnet.json / .localnet.json
# dev-stack.sh only: override the program id it deploys / targets. Defaults to
# declare_id! in programs/vault/src/lib.rs, which is authoritative. The program
# rejects every instruction at any other address.
PROGRAM_ID=G4E1BiuovMpeUCgyh2222GqAQt4cW5dXSovZipFd89T1
